# Server / local use: copy to automation/.env (gitignored) and fill in.
# GitHub engine: add the same names as repository secrets instead
# (Settings > Secrets and variables > Actions > New repository secret).

# --- Notifications: configure at least one -------------------------------------
# ntfy: install the ntfy app and subscribe to a long random topic. On the public
# ntfy.sh server the topic name is the only access control.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=
# Telegram: create a bot with @BotFather, message it once, then read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
# Email over SMTP (Gmail: smtp.gmail.com, port 587, an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# --- Dead-man's switches (e.g. healthchecks.io ping URLs) ------------------------
# Pinged by the heartbeat job:
HEARTBEAT_URL=
# Pinged every 5 minutes by `python -m ops serve` itself:
OPS_HEARTBEAT_URL=

# --- Claude headless jobs (type: claude): set one ------------------------------
# Subscription token from `claude setup-token` (valid one year; model requests only):
CLAUDE_CODE_OAUTH_TOKEN=
# Or a pay-per-token API key from the Claude Console (also enables --bare mode):
ANTHROPIC_API_KEY=

# --- Claude Cloud Routine bridge (jobs with `routine: deep_dive`) ---------------
ROUTINE_DEEP_DIVE_URL=
ROUTINE_DEEP_DIVE_TOKEN=
